FROM python:3.11-slim
RUN useradd --create-home --uid 10001 appuser
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY demo ./demo
COPY demo_data ./demo_data
COPY scripts ./scripts
COPY corpus/raw ./corpus/raw
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir . \
    && pip install --no-cache-dir 'streamlit>=1.40,<2'
RUN python scripts/seed_demo.py
RUN chown -R appuser:appuser /app
USER appuser
EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')"
CMD ["streamlit", "run", "demo/app.py", "--server.address", "0.0.0.0", "--server.port", "8501", "--server.headless", "true"]
